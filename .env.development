# En desarrollo el SPA llama rutas relativas y Vite hace de proxy (ver vite.config.ts).
# Esto evita el problema de CORS del API de Seguridad mientras se habilita en el backend.
VITE_API_SEGURIDAD=/api-seguridad
VITE_URL_PATH=https://imagenes.recamier.com:8443/eva

# Destino real del proxy de desarrollo
SEGURIDAD_PROXY_TARGET=https://eva.recamier.com:8471
